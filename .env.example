# Production must use an identity provider. Do not set GEO_CLOUD_ENV=development
# on a network-accessible deployment.
GEO_CLOUD_ENV=production

# Auth0 API configuration. Create an API whose identifier is AUTH0_AUDIENCE.
AUTH0_DOMAIN=your-tenant.region.auth0.com
AUTH0_AUDIENCE=https://geo-cloud.example/api
AUTH0_ISSUER=https://your-tenant.region.auth0.com/

# PostgreSQL connection used by both the API and the background worker.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/gis_jobs

# Local filesystem storage for GeoJSON payloads. Use a persistent volume.
GEO_CLOUD_DATASETS_DIR=./data/datasets

# Optional: comma-separated browser origins for the frontend.
GEO_CLOUD_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Dataset management. Uploaded GeoJSON is limited to 25 MiB by default.
GEO_CLOUD_STORAGE_BACKEND=local
GEO_CLOUD_MAX_UPLOAD_BYTES=26214400

GEO_CLOUD_CORS_METHODS=GET,POST,DELETE,OPTIONS
GEO_CLOUD_CORS_HEADERS=Authorization,Content-Type


DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30

POSTGRES_DB=gis_jobs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-dev-change-this

# Redis metadata cache. Compose overrides the host with its internal Redis service.
REDIS_URL=redis://localhost:6379/0